    },
    "Output": {
      "lhs": {"kind": "block", "name": "nt_output"},
      "rhs": {"kind": "block", "name": "out_ptr0"}
    }
  },
  "facts": {
    "bindings": {
      "M": 8,
      "N": 16,
      "X": 128,
      "input_stride0": 16,
