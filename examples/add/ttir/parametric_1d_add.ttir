module {
  tt.func public @parametric_1d_add(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: !tt.ptr<f32>, %arg4: i32) {
    %c128_i32 = arith.constant 128 : i32
    %zero = arith.constant 0.000000e+00 : f32
    %pid = tt.get_program_id x : i32
    %base = arith.muli %pid, %c128_i32 : i32
    %range = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %base_vector = tt.splat %base : i32 -> tensor<128xi32>
    %index = arith.addi %base_vector, %range : tensor<128xi32>
    %numel = tt.splat %arg4 : i32 -> tensor<128xi32>
    %mask = arith.cmpi slt, %index, %numel : tensor<128xi32>
    %zeros = tt.splat %zero : f32 -> tensor<128xf32>

    %input_base = tt.splat %arg0 : !tt.ptr<f32> -> tensor<128x!tt.ptr<f32>>
    %input_pointer = tt.addptr %input_base, %index : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    %input = tt.load %input_pointer, %mask, %zeros : tensor<128x!tt.ptr<f32>>

    %alpha = tt.load %arg1 : !tt.ptr<f32>
    %alpha_vector = tt.splat %alpha : f32 -> tensor<128xf32>
    %other_base = tt.splat %arg2 : !tt.ptr<f32> -> tensor<128x!tt.ptr<f32>>
    %other_pointer = tt.addptr %other_base, %index : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    %other = tt.load %other_pointer, %mask, %zeros : tensor<128x!tt.ptr<f32>>

    %scaled = arith.mulf %alpha_vector, %other : tensor<128xf32>
    %result = arith.addf %input, %scaled : tensor<128xf32>

    %output_base = tt.splat %arg3 : !tt.ptr<f32> -> tensor<128x!tt.ptr<f32>>
    %output_pointer = tt.addptr %output_base, %index : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    tt.store %output_pointer, %result, %mask : tensor<128x!tt.ptr<f32>>
    tt.return
  }
}
