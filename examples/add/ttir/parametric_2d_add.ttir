module {
  tt.func public @parametric_2d_add(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: f32, %arg3: !tt.ptr<f32>, %arg4: i32, %arg5: i32) {
    %c256_i32 = arith.constant 256 : i32
    %zero = arith.constant 0.000000e+00 : f32
    %pid = tt.get_program_id x : i32
    %base = arith.muli %pid, %c256_i32 : i32
    %range = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
    %base_vector = tt.splat %base : i32 -> tensor<256xi32>
    %index = arith.addi %base_vector, %range : tensor<256xi32>

    %numel_scalar = arith.muli %arg4, %arg5 : i32
    %numel = tt.splat %numel_scalar : i32 -> tensor<256xi32>
    %mask = arith.cmpi slt, %index, %numel : tensor<256xi32>
    %width = tt.splat %arg5 : i32 -> tensor<256xi32>
    %row = arith.divsi %index, %width : tensor<256xi32>
    %column = arith.remsi %index, %width : tensor<256xi32>
    %row_offset = arith.muli %row, %width : tensor<256xi32>
    %offset = arith.addi %row_offset, %column : tensor<256xi32>
    %zeros = tt.splat %zero : f32 -> tensor<256xf32>

    %input_base = tt.splat %arg0 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>>
    %input_pointer = tt.addptr %input_base, %offset : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
    %input = tt.load %input_pointer, %mask, %zeros : tensor<256x!tt.ptr<f32>>

    %other_base = tt.splat %arg1 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>>
    %other_pointer = tt.addptr %other_base, %offset : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
    %other = tt.load %other_pointer, %mask, %zeros : tensor<256x!tt.ptr<f32>>

    %alpha = tt.splat %arg2 : f32 -> tensor<256xf32>
    %scaled = arith.mulf %alpha, %other : tensor<256xf32>
    %result = arith.addf %input, %scaled : tensor<256xf32>

    %output_base = tt.splat %arg3 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>>
    %output_pointer = tt.addptr %output_base, %offset : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
    tt.store %output_pointer, %result, %mask : tensor<256x!tt.ptr<f32>>
    tt.return
  }
}
