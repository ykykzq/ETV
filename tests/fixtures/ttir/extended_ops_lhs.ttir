module {
  tt.func public @extended_lhs(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: !tt.ptr<f32>, %arg4: i32) {
    %c8 = arith.constant dense<8> : tensor<8xi32>
    %0 = tt.make_range {end = 8 : i32, start = 0 : i32} : tensor<8xi32>
    %1 = tt.splat %arg4 : i32 -> tensor<8xi32>
    %2 = arith.cmpi slt, %0, %1 : tensor<8xi32>
    %3 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %4 = tt.addptr %3, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %5 = tt.load %4, %2 : tensor<8x!tt.ptr<f32>>
    %6 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %7 = tt.addptr %6, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %8 = tt.load %7, %2 : tensor<8x!tt.ptr<f32>>
    %9 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %10 = tt.addptr %9, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %11 = tt.load %10, %2 : tensor<8x!tt.ptr<f32>>
    %12 = tt.clampf %5, %8, %11, propagateNan = none : tensor<8xf32>
    %13 = math.exp %12 : tensor<8xf32>
    %14 = math.erf %13 : tensor<8xf32>
    %15 = tt.splat %arg3 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %16 = tt.addptr %15, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    tt.store %16, %14, %2 : tensor<8x!tt.ptr<f32>>
    tt.return
  }
}
