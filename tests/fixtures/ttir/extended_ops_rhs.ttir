module {
  tt.func public @extended_rhs(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: !tt.ptr<f32>, %arg4: i32) {
    %0 = tt.make_range {end = 8 : i32, start = 0 : i32} : tensor<8xi32>
    %1 = tt.splat %arg4 : i32 -> tensor<8xi32>
    %2 = arith.cmpi slt, %0, %1 : tensor<8xi32>
    %3 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %4 = tt.addptr %3, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %5 = tt.load %4, %2 : tensor<8x!tt.ptr<f32>>
    %6 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %7 = tt.addptr %6, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %8 = tt.load %7, %2 : tensor<8x!tt.ptr<f32>>
    %9 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %10 = tt.addptr %9, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %11 = tt.load %10, %2 : tensor<8x!tt.ptr<f32>>
    %12 = arith.cmpf ogt, %5, %8 : tensor<8xf32>
    %13 = arith.cmpf une, %5, %5 : tensor<8xf32>
    %14 = arith.ori %12, %13 : tensor<8xi1>
    %15 = arith.select %14, %5, %8 : tensor<8xi1>, tensor<8xf32>
    %16 = arith.cmpf olt, %15, %11 : tensor<8xf32>
    %17 = arith.cmpf une, %15, %15 : tensor<8xf32>
    %18 = arith.ori %16, %17 : tensor<8xi1>
    %19 = arith.select %18, %15, %11 : tensor<8xi1>, tensor<8xf32>
    %20 = math.exp %19 : tensor<8xf32>
    %21 = tt.extern_elementwise %20 {libname = "", libpath = "", pure = true, symbol = "__nv_erff"} : (tensor<8xf32>) -> tensor<8xf32>
    %22 = tt.splat %arg3 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %23 = tt.addptr %22, %0 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    tt.store %23, %21, %2 : tensor<8x!tt.ptr<f32>>
    tt.return
  }
}
