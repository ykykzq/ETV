module {
  tt.func public @multilaunch_mul(%arg0: !tt.ptr<f32>, %arg1: f32, %arg2: !tt.ptr<f32>, %arg3: i32) {
    %c128 = arith.constant 128 : i32
    %pid = tt.get_program_id x : i32
    %base = arith.muli %pid, %c128 : i32
    %range = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %base_vector = tt.splat %base : i32 -> tensor<128xi32>
    %index = arith.addi %base_vector, %range : tensor<128xi32>
    %numel = tt.splat %arg3 : i32 -> tensor<128xi32>
    %mask = arith.cmpi slt, %index, %numel : tensor<128xi32>
    %zero = arith.constant 0.000000e+00 : f32
    %zeros = tt.splat %zero : f32 -> tensor<128xf32>
    %other_base = tt.splat %arg0 : !tt.ptr<f32> -> tensor<128x!tt.ptr<f32>>
    %other_ptr = tt.addptr %other_base, %index : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    %other = tt.load %other_ptr, %mask, %zeros : tensor<128x!tt.ptr<f32>>
    %alpha = tt.splat %arg1 : f32 -> tensor<128xf32>
    %scaled = arith.mulf %other, %alpha : tensor<128xf32>
    %tmp_base = tt.splat %arg2 : !tt.ptr<f32> -> tensor<128x!tt.ptr<f32>>
    %tmp_ptr = tt.addptr %tmp_base, %index : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    tt.store %tmp_ptr, %scaled, %mask : tensor<128x!tt.ptr<f32>>
    tt.return
  }
}
