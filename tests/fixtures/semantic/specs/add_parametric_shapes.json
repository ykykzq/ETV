{
  "format": "etv-pair-v1",
  "pair_id": "add_symbolic_shape_2d_vs_1d",
  "lhs": "../programs/add_symbolic_2d.json",
  "rhs": "../programs/add_symbolic_1d.json",
  "semantic_mode": "abstract_float",
  "roles": {
    "Alpha": {
      "lhs": {"kind": "scalar", "name": "lhs_alpha"},
      "rhs": {"kind": "scalar_block", "name": "rhs_alpha", "index": 0}
    },
    "Input": {
      "lhs": {"kind": "block", "name": "lhs_input"},
      "rhs": {"kind": "block", "name": "rhs_input"}
    },
    "Other": {
      "lhs": {"kind": "block", "name": "lhs_other"},
      "rhs": {"kind": "block", "name": "rhs_other"}
    },
    "Output": {
      "lhs": {"kind": "block", "name": "lhs_output"},
      "rhs": {"kind": "block", "name": "rhs_output"}
    }
  },
  "facts": {
    "bindings": {},
    "parameters": {
      "a": {"min": 1},
      "b": {"min": 1},
      "c": {"min": 1}
    },
    "constraints": [
      {"op": "eq", "args": [{"op": "imul", "args": [{"var": "a"}, {"var": "b"}]}, {"var": "c"}]}
    ],
    "assumptions": [],
    "disjoint": [["Input", "Other", "Alpha", "Output"]]
  },
  "contract": {
    "output_role": "Output",
    "output_numel": {"var": "c"},
    "require_full_coverage": true,
    "require_disjoint": ["Input", "Other", "Alpha", "Output"]
  },
  "limits": {"max_iterations": 8, "max_enodes": 20000, "timeout_ms": 10000}
}
