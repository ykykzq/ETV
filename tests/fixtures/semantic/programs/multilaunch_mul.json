{
  "format": "etv-semantic-program-v1",
  "name": "multilaunch_mul",
  "launch": {"programs": 1, "lanes": 4},
  "stores": [
    {
      "block": "tmp",
      "logical_index": {"var": "lane"},
      "offset": {"var": "lane"},
      "mask": true,
      "value": {
        "op": "fmul",
        "args": [
          {"op": "load", "block": "x", "offset": {"var": "lane"}, "mask": true, "default": {"float": "0"}},
          {"op": "load", "block": "y", "offset": {"var": "lane"}, "mask": true, "default": {"float": "0"}}
        ]
      }
    }
  ]
}
